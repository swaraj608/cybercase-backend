generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CITIZEN
  OFFICER
  SUPERVISOR
  ADMIN
}

enum CaseStatus {
  REGISTERED
  VERIFICATION
  ASSIGNED
  UNDER_INVESTIGATION
  ACTION_REQUIRED
  ESCALATED
  TRANSFERRED
  RESOLVED
  CLOSED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  citizenCases       Case[]         @relation("CitizenCases")
  officerProfile     Officer?
  assignedCases      Case[]         @relation("AssignedCases")
  assignments        Assignment[] @relation("OfficerAssignments")
  assignedAssignments Assignment[] @relation("AssignedByUser")
  caseHistoryChanges CaseHistory[]
  notifications      Notification[]
  uuploadedAttachments Attachment[] @relation("UploadedAttachments")
  auditLogs          AuditLog[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model Officer {
  id           String   @id @default(uuid())
  userId       String   @unique
  badgeNumber  String?  @unique
  department   String?
  designation  String?
  jurisdiction String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@map("officers")
}

model Case {
  id                 String       @id @default(uuid())
  caseNumber         String       @unique
  citizenId          String
  assignedOfficerId  String?
  category           String
  description        String
  district           String?
  priority           CasePriority @default(MEDIUM)
  currentStatus      CaseStatus   @default(REGISTERED)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  closedAt           DateTime?

  citizen          User          @relation("CitizenCases", fields: [citizenId], references: [id])
  assignedOfficer  User?         @relation("AssignedCases", fields: [assignedOfficerId], references: [id])
  assignments      Assignment[]
  history          CaseHistory[]
  notifications    Notification[]
  attachments      Attachment[]
  auditLogs        AuditLog[]

  @@index([citizenId])
  @@index([assignedOfficerId])
  @@index([currentStatus])
  @@index([priority])
  @@index([district])
  @@index([createdAt])
  @@map("cases")
}

model Assignment {
  id           String    @id @default(uuid())
  caseId       String
  officerId    String
  assignedById String
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  reason       String?

  case       Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  officer    User @relation("OfficerAssignments", fields: [officerId], references: [id])
  assignedBy User @relation("AssignedByUser", fields: [assignedById], references: [id])

  @@index([caseId])
  @@index([officerId])
  @@index([assignedAt])
  @@map("assignments")
}

model CaseHistory {
  id          String      @id @default(uuid())
  caseId     String
  changedById String
  oldStatus   CaseStatus?
  newStatus   CaseStatus
  remarks     String?
  createdAt   DateTime    @default(now())

  case       Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedBy  User @relation(fields: [changedById], references: [id])

  @@index([caseId])
  @@index([changedById])
  @@index([createdAt])
  @@map("case_history")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  caseId    String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([caseId])
  @@index([createdAt])
  @@map("notifications")
}

model Attachment {
  id           String   @id @default(uuid())
  caseId       String
  uploadedById String
  fileName     String
  objectKey    String
  contentType  String?
  fileSize     Int?
  createdAt    DateTime @default(now())

  case       Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("UploadedAttachments", fields: [uploadedById], references: [id])

  @@index([caseId])
  @@index([uploadedById])
  @@map("attachments")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  caseId    String?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  case Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([caseId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}